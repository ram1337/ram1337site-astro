---
interface Props {
  channel?: string;
  commentsLimit?: number;
  discussion?: string;
  enabled?: boolean;
  postId?: number | string;
}

const {
  channel = "ram1337_log",
  commentsLimit = 10,
  discussion,
  enabled = true,
  postId,
} = Astro.props as Props;

const normalizedPostId =
  postId === undefined || postId === null || postId === ""
    ? undefined
    : String(postId).replace(/^\/+/, "");

const discussionPath =
  discussion?.trim() || (normalizedPostId ? `${channel}/${normalizedPostId}` : undefined);

const containerId = discussionPath
  ? `telegram-comments-${discussionPath.replace(/[^a-zA-Z0-9_-]/g, "-")}`
  : undefined;
---

{
  enabled && discussionPath && containerId && (
    <section
      class="mt-10 border-t border-slate-200 pt-8 dark:border-slate-800"
      aria-labelledby="telegram-comments-title"
    >
      <h2
        id="telegram-comments-title"
        class="mb-4 text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50"
      >
        Комментарии
      </h2>

      <div
        id={containerId}
        class="min-h-24 overflow-hidden rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-950"
      />

      <script
        is:inline
        define:vars={{ commentsLimit, containerId, discussionPath }}
      >
        (function () {
          const container = document.getElementById(containerId);
          if (!container) return;

          const script = document.createElement("script");
          script.async = true;
          script.src = "https://telegram.org/js/telegram-widget.js?22";
          script.setAttribute("data-telegram-discussion", discussionPath);
          script.setAttribute("data-comments-limit", String(commentsLimit));
          script.setAttribute("data-width", "100%");

          if (document.documentElement.classList.contains("dark")) {
            script.setAttribute("data-dark", "1");
          }

          container.appendChild(script);
        })();
      </script>
    </section>
  )
}
