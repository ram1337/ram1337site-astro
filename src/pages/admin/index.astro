---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Администрирование - ram1337">
  <section class="space-y-6">
    <header
      class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    >
      <div class="space-y-2">
        <p
          class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400"
        >
          /admin
        </p>
        <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-50">
          Управление
        </h1>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Пользователи, серверы и удалённые доступы
        </p>
      </div>

      <a
        href="/cp/"
        class="inline-flex min-h-10 items-center justify-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
      >
        Личный кабинет
      </a>
    </header>

    <div
      id="admin-loading"
      class="rounded-lg border border-slate-200 bg-white px-4 py-5 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
    >
      Проверяем права администратора...
    </div>

    <div
      id="admin-access-error"
      role="alert"
      class="hidden rounded-lg border border-rose-200 bg-rose-50 px-4 py-4 text-sm font-medium text-rose-700 dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-rose-200"
    >
    </div>

    <div id="admin-content" class="hidden space-y-6">
      <div
        id="admin-notice"
        role="status"
        class="hidden rounded-lg border px-4 py-3 text-sm"
      >
      </div>

      <nav
        class="flex gap-1 overflow-x-auto border-b border-slate-200 dark:border-slate-800"
        aria-label="Разделы администрирования"
      >
        <button
          type="button"
          data-admin-tab="users"
          class="shrink-0 border-b-2 border-violet-500 px-4 py-3 text-sm font-semibold text-violet-700 dark:text-violet-300"
          aria-selected="true"
        >
          Пользователи
        </button>
        <button
          type="button"
          data-admin-tab="servers"
          class="shrink-0 border-b-2 border-transparent px-4 py-3 text-sm font-medium text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
          aria-selected="false"
        >
          Серверы
        </button>
        <button
          type="button"
          data-admin-tab="unnamed"
          class="shrink-0 border-b-2 border-transparent px-4 py-3 text-sm font-medium text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
          aria-selected="false"
        >
          Безымянные доступы
        </button>
      </nav>

      <section id="admin-tab-users" data-admin-panel="users" class="space-y-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-50">
              Пользователи
            </h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Аккаунты и VPN-пользователи без аккаунта
            </p>
          </div>
          <button
            id="create-user-toggle"
            type="button"
            class="inline-flex min-h-10 items-center justify-center rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500"
          >
            Создать
          </button>
        </div>

        <form
          id="create-user-form"
          class="hidden space-y-4 rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950"
          novalidate
        >
          <div class="flex items-center justify-between gap-4">
            <h3 class="font-semibold text-slate-900 dark:text-slate-50">
              Новый пользователь
            </h3>
            <button
              id="create-user-cancel"
              type="button"
              class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
            >
              Отмена
            </button>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
              <span>Логин</span>
              <input
                id="create-user-login"
                type="text"
                autocomplete="username"
                required
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              />
              <span
                id="create-user-login-error"
                class="hidden text-sm text-rose-600 dark:text-rose-300"
              ></span>
            </label>
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
              <span>Имя <span class="text-slate-400">(необязательно)</span></span>
              <input
                id="create-user-name"
                type="text"
                autocomplete="name"
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              />
              <span
                id="create-user-name-error"
                class="hidden text-sm text-rose-600 dark:text-rose-300"
              ></span>
            </label>
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
              <span>Пароль</span>
              <input
                id="create-user-password"
                type="password"
                autocomplete="new-password"
                minlength="8"
                required
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              />
              <span
                id="create-user-password-error"
                class="hidden text-sm text-rose-600 dark:text-rose-300"
              ></span>
            </label>
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
              <span>Оплачено до</span>
              <input
                id="create-user-paid-until"
                type="date"
                required
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              />
              <span
                id="create-user-paid-until-error"
                class="hidden text-sm text-rose-600 dark:text-rose-300"
              ></span>
            </label>
          </div>
          <div
            id="create-user-error"
            class="hidden rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-200"
          ></div>
          <button
            id="create-user-submit"
            type="submit"
            class="inline-flex min-h-10 items-center justify-center rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500 disabled:opacity-60"
          >
            Создать пользователя
          </button>
        </form>

        <label class="block space-y-1 text-sm text-slate-600 dark:text-slate-300">
          <span>Поиск по логину</span>
          <input
            id="users-login-search"
            type="search"
            autocomplete="off"
            placeholder="Введите login"
            class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
          />
        </label>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
            <span>Статус</span>
            <select
              id="users-block-filter"
              class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
            >
              <option value="all">Все</option>
              <option value="active">Активные</option>
              <option value="blocked">Заблокированные</option>
            </select>
          </label>
          <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
            <span>Оплата</span>
            <select
              id="users-payment-filter"
              class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
            >
              <option value="all">Все</option>
              <option value="paid">Оплачено</option>
              <option value="unpaid">Не оплачено</option>
              <option value="expired">Просрочено</option>
            </select>
          </label>
          <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
            <span>Роль</span>
            <select
              id="users-role-filter"
              class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
            >
              <option value="all">Все</option>
              <option value="user">Пользователи</option>
              <option value="admin">Администраторы</option>
            </select>
          </label>
          <button
            id="users-reload"
            type="button"
            class="mt-auto inline-flex h-11 items-center justify-center rounded-lg border border-slate-300 px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-100 disabled:opacity-60 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
          >
            Обновить
          </button>
        </div>

        <div
          id="users-error"
          class="hidden rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-200"
        >
        </div>
        <div
          id="users-loading"
          class="hidden py-8 text-center text-sm text-slate-500 dark:text-slate-400"
        >
          Загружаем пользователей...
        </div>
        <div
          id="users-empty"
          class="hidden rounded-lg border border-dashed border-slate-300 px-4 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400"
        >
          Пользователи не найдены.
        </div>

        <div
          id="users-table-wrap"
          class="hidden overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-800"
        >
          <table class="w-full min-w-[840px] text-left text-sm">
            <thead
              class="bg-slate-100 text-xs uppercase text-slate-500 dark:bg-slate-900 dark:text-slate-400"
            >
              <tr>
                <th class="px-4 py-3 font-semibold">Логин</th>
                <th class="px-4 py-3 font-semibold">Имя</th>
                <th class="px-4 py-3 font-semibold">Тип</th>
                <th class="px-4 py-3 font-semibold">Роль</th>
                <th class="px-4 py-3 font-semibold">Статус</th>
                <th class="px-4 py-3 font-semibold">Оплачено до</th>
                <th class="px-4 py-3 font-semibold">VPN-доступы</th>
                <th class="px-4 py-3 text-right font-semibold">Действие</th>
              </tr>
            </thead>
            <tbody
              id="users-table-body"
              class="divide-y divide-slate-200 bg-white dark:divide-slate-800 dark:bg-slate-950"
            ></tbody>
          </table>
        </div>

        <section
          id="user-detail"
          class="hidden space-y-6 border-t border-slate-200 pt-6 dark:border-slate-800"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p
                class="text-xs font-semibold uppercase text-slate-500 dark:text-slate-400"
              >
                Пользователь
              </p>
              <h2
                id="user-detail-title"
                class="mt-1 text-xl font-semibold text-slate-900 dark:text-slate-50"
              >
                -
              </h2>
              <div id="user-detail-type" class="mt-2"></div>
            </div>
            <div class="flex flex-wrap justify-end gap-2">
              <button
                id="user-revoke-all-accesses"
                type="button"
                class="hidden rounded-lg border border-rose-300 px-3 py-2 text-sm font-medium text-rose-700 hover:bg-rose-50 disabled:opacity-60 dark:border-rose-800 dark:text-rose-200 dark:hover:bg-rose-950/40"
              >
                Отозвать все сертификаты
              </button>
              <button
                id="user-detail-close"
                type="button"
                class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
                >Закрыть</button
              >
            </div>
          </div>

          <div
            id="user-revoke-all-result"
            class="hidden rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/60"
          >
            <h3 class="font-semibold text-slate-900 dark:text-slate-50">
              Результат отзыва
            </h3>
            <div id="user-revoke-all-result-list" class="mt-3 space-y-2"></div>
          </div>

          <form
            id="user-edit-form"
            class="grid gap-4 sm:grid-cols-2"
            novalidate
          >
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
              <span>Имя</span>
              <input
                id="user-name"
                type="text"
                required
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              />
            </label>
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
              <span>Логин</span>
              <input
                id="user-login"
                type="text"
                required
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              />
            </label>
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
              <span>Роль</span>
              <select
                id="user-role"
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              >
                <option value="user">Пользователь</option>
                <option value="admin">Администратор</option>
              </select>
            </label>
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
              <span>Оплачено до</span>
              <input
                id="user-paid-until"
                type="date"
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              />
            </label>
            <div class="flex flex-wrap gap-3 sm:col-span-2">
              <button
                id="user-save"
                type="submit"
                class="inline-flex min-h-10 items-center justify-center rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500 disabled:opacity-60"
                >Сохранить</button
              >
              <button
                id="user-block-toggle"
                type="button"
                class="inline-flex min-h-10 items-center justify-center rounded-lg border border-rose-300 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-50 disabled:opacity-60 dark:border-rose-800 dark:text-rose-200 dark:hover:bg-rose-950/40"
                >Заблокировать</button
              >
            </div>
          </form>

          <form
            id="user-password-form"
            class="grid gap-4 border-t border-slate-200 pt-5 sm:grid-cols-2 dark:border-slate-800"
            novalidate
          >
            <h3
              class="text-base font-semibold text-slate-900 sm:col-span-2 dark:text-slate-50"
            >
              Сменить пароль
            </h3>
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
              <span>Новый пароль</span>
              <input
                id="user-password"
                type="password"
                autocomplete="new-password"
                required
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              />
            </label>
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
              <span>Подтверждение</span>
              <input
                id="user-password-confirmation"
                type="password"
                autocomplete="new-password"
                required
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              />
            </label>
            <div class="sm:col-span-2">
              <button
                id="user-password-save"
                type="submit"
                class="inline-flex min-h-10 items-center justify-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100 disabled:opacity-60 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
                >Обновить пароль</button
              >
            </div>
          </form>

          <div
            class="space-y-3 border-t border-slate-200 pt-5 dark:border-slate-800"
          >
            <h3
              class="text-base font-semibold text-slate-900 dark:text-slate-50"
            >
              VPN-доступы
            </h3>
            <div id="user-ikev2-accesses" class="space-y-3"></div>
            <div id="user-accesses" class="space-y-2"></div>
          </div>
        </section>
      </section>

      <section
        id="admin-tab-servers"
        data-admin-panel="servers"
        class="hidden space-y-5"
      >
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-50">
              VPN-серверы
            </h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Параметры подключения и локации
            </p>
          </div>
          <button
            id="servers-reload"
            type="button"
            class="inline-flex min-h-10 items-center justify-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 disabled:opacity-60 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
            >Обновить</button
          >
        </div>
        <div
          id="admin-servers-error"
          class="hidden rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-200"
        >
        </div>
        <div
          id="admin-servers-loading"
          class="hidden py-8 text-center text-sm text-slate-500 dark:text-slate-400"
        >
          Загружаем серверы...
        </div>
        <div
          id="admin-servers-empty"
          class="hidden rounded-lg border border-dashed border-slate-300 px-4 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400"
        >
          Серверы не найдены.
        </div>
        <div id="admin-servers-list" class="grid gap-3 sm:grid-cols-2"></div>

        <form
          id="server-edit-form"
          class="hidden space-y-5 border-t border-slate-200 pt-6 dark:border-slate-800"
          novalidate
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p
                class="text-xs font-semibold uppercase text-slate-500 dark:text-slate-400"
              >
                Редактирование
              </p>
              <h2
                id="server-detail-title"
                class="mt-1 text-xl font-semibold text-slate-900 dark:text-slate-50"
              >
                -
              </h2>
            </div>
            <button
              id="server-detail-close"
              type="button"
              class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
              >Закрыть</button
            >
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300"
              ><span>Slug</span><input
                id="server-slug"
                type="text"
                required
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              /></label
            >
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300"
              ><span>Тип</span><input
                id="server-type"
                type="text"
                required
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              /></label
            >
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300"
              ><span>Host</span><input
                id="server-host"
                type="text"
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              /></label
            >
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300"
              ><span>SSH-порт</span><input
                id="server-ssh-port"
                type="number"
                min="1"
                max="65535"
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              /></label
            >
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300"
              ><span>Подсеть</span><input
                id="server-subnet"
                type="text"
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              /></label
            >
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300"
              ><span>Endpoint</span><input
                id="server-endpoint"
                type="text"
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              /></label
            >
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300"
              ><span>Страна</span><input
                id="server-country"
                type="text"
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              /></label
            >
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300"
              ><span>Флаг</span><input
                id="server-flag"
                type="text"
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              /></label
            >
            <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300"
              ><span>Город</span><input
                id="server-city"
                type="text"
                class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              /></label
            >
            <label
              class="flex items-center gap-3 pt-6 text-sm font-medium text-slate-700 dark:text-slate-200"
              ><input
                id="server-enabled"
                type="checkbox"
                class="h-5 w-5 rounded border-slate-300 text-violet-600"
              />Сервер включён</label
            >
            <label
              class="space-y-1 text-sm text-slate-600 sm:col-span-2 dark:text-slate-300"
              ><span>Metadata (JSON)</span><textarea
                id="server-metadata"
                rows="5"
                class="w-full rounded-lg border border-slate-300 bg-white p-3 font-mono text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              ></textarea></label
            >
          </div>
          <button
            id="server-save"
            type="submit"
            class="inline-flex min-h-10 items-center justify-center rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500 disabled:opacity-60"
            >Сохранить сервер</button
          >
        </form>
      </section>

      <section
        id="admin-tab-unnamed"
        data-admin-panel="unnamed"
        class="hidden space-y-5"
      >
        <div
          class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"
        >
          <div>
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-50">
              Безымянные доступы
            </h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Unmanaged-доступы и расхождения с локальной базой
            </p>
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
            <span>Сервер</span>
            <select
              id="unnamed-server-filter"
              class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              ><option value="">Все серверы</option></select
            >
          </label>
          <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
            <span>Причина</span>
            <select
              id="unnamed-reason-filter"
              class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              ><option value="">Все причины</option></select
            >
          </label>
          <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
            <span>Login</span>
            <select
              id="unnamed-login-filter"
              class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
            >
              <option value="all">Все</option>
              <option value="with">С login</option>
              <option value="without">Без login</option>
            </select>
          </label>
          <label class="space-y-1 text-sm text-slate-600 dark:text-slate-300">
            <span>Совпадение</span>
            <select
              id="unnamed-match-filter"
              class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
            >
              <option value="all">Все</option>
              <option value="remote_identifier">remote_identifier</option>
              <option value="vpn_ip">vpn_ip</option>
              <option value="none">none</option>
            </select>
          </label>
        </div>
        <div class="flex justify-end">
          <button
            id="unnamed-reload"
            type="button"
            class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 px-4 text-sm font-medium text-slate-700 hover:bg-slate-100 disabled:opacity-60 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
            >Обновить</button
          >
        </div>
        <div
          id="unnamed-error"
          class="hidden rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-200"
        >
        </div>
        <div
          id="unnamed-loading"
          class="hidden py-8 text-center text-sm text-slate-500 dark:text-slate-400"
        >
          Проверяем удалённые доступы...
        </div>
        <div
          id="unnamed-empty"
          class="hidden rounded-lg border border-dashed border-slate-300 px-4 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400"
        >
          Доступы по выбранным фильтрам не найдены.
        </div>
        <div
          id="unnamed-table-wrap"
          class="hidden overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-800"
        >
          <table class="w-full min-w-[1240px] text-left text-sm">
            <thead
              class="bg-slate-100 text-xs uppercase text-slate-500 dark:bg-slate-900 dark:text-slate-400"
            >
              <tr>
                <th class="px-3 py-3 font-semibold">Сервер</th>
                <th class="px-3 py-3 font-semibold">IP</th>
                <th class="px-3 py-3 font-semibold">Login</th>
                <th class="px-3 py-3 font-semibold">Оплачено до</th>
                <th class="px-3 py-3 font-semibold">Причина</th>
                <th class="px-3 py-3 font-semibold">Совпадение</th>
                <th class="px-3 py-3 font-semibold">Public key</th>
                <th class="px-3 py-3 text-right font-semibold">Действия</th>
              </tr>
            </thead>
            <tbody
              id="unnamed-table-body"
              class="divide-y divide-slate-200 bg-white dark:divide-slate-800 dark:bg-slate-950"
            ></tbody>
          </table>
        </div>
      </section>
    </div>
  </section>

  <script>
    import "../../scripts/admin";
  </script>
</BaseLayout>
